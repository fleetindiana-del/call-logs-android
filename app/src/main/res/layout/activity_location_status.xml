<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS DIAGNOSTICS"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDutyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off Duty"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvGpsEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS enabled: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location permission: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBatteryOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery optimisation: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAST READING"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLastPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last point: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAccuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accuracy: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOCAL STORAGE"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLocalCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total local points: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPendingUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending upload: —"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnFixSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Open Location Settings"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
