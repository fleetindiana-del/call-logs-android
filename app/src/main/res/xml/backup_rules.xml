<?xml version="1.0" encoding="utf-8"?>
<!--
   Applies to API 30 and below (API 31+ uses data_extraction_rules.xml).

   fleet_enrollment is an EncryptedSharedPreferences store sealed with an AndroidKeystore
   master key. That key is device-bound and is never backed up, so a restored copy of this
   file can never be decrypted — it only produces a device that looks enrolled but reports
   a missing device token. Exclude it and let the user re-enroll cleanly.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="fleet_enrollment.xml" />
    <exclude domain="sharedpref" path="fleet_enrollment_fallback.xml" />
</full-backup-content>
