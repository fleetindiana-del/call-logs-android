<?xml version="1.0" encoding="utf-8"?>
<!--
   Applies to API 31+. See backup_rules.xml for the API 30-and-below equivalent.

   fleet_enrollment holds EncryptedSharedPreferences sealed with a device-bound
   AndroidKeystore master key that is never backed up, so a restored copy is
   permanently undecryptable and surfaces as a bogus "device token missing" error.
   Exclude it from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fleet_enrollment.xml" />
        <exclude domain="sharedpref" path="fleet_enrollment_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fleet_enrollment.xml" />
        <exclude domain="sharedpref" path="fleet_enrollment_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
